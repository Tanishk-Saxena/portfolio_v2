# Copy to .env.local (never committed). See docs/SUPABASE.md.

# The DEV project locally; Vercel holds prod (Production) and dev (Preview). The site and the
# admin read and write through these: there is one data path, Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Server only: a read-only GitHub token for the contribution heat map (GraphQL needs one; a
# fine-grained token with no extra permissions is enough). Locally and in Vercel. Without it,
# or without a username in Settings, the heat map is simply not shown.
GITHUB_TOKEN=

# Optional, local only: Postgres connection strings for `npx supabase db push --db-url`
# (Project Settings → Database → Connection string). Never in Vercel or CI.
SUPABASE_DB_URL=
SUPABASE_PROD_DB_URL=
