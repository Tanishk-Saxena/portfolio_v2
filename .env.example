# Copy to .env.local (never committed). See docs/SUPABASE.md.

# fixtures (default) | fixtures-stress | supabase
DATA_SOURCE=fixtures

# The DEV project locally; Vercel holds prod (Production) and dev (Preview).
# The admin's sign-in uses these too, whatever DATA_SOURCE says.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Dev only, local only: lets the Supabase tests plant hidden rows. Never in Vercel.
SUPABASE_SECRET_KEY=

# Local signed-in admin e2e runs (smoke + axe): the dev project's test admin
# (docs/SUPABASE.md). CI reads the same from repository secrets.
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# Optional, local only: Postgres connection strings for `npx supabase db push --db-url`
# (Project Settings → Database → Connection string). Never in Vercel or CI.
SUPABASE_DB_URL=
SUPABASE_PROD_DB_URL=
