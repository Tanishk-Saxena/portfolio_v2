#!/bin/sh
# Refuse commits made directly on main — work on a feature branch (see CONTRIBUTING.md).
branch=$(git symbolic-ref --short HEAD 2>/dev/null)
if [ "$branch" = "main" ]; then
  echo "✖ Direct commits to main are blocked. Create a branch first:"
  echo "    git switch -c feat/<short-description>"
  echo "  (Emergency only: git commit --no-verify)"
  exit 1
fi
