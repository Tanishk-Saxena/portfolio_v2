#!/bin/sh
# Refuse pushes that update main — changes reach main only through a pull request.
# stdin lines: <local ref> <local sha> <remote ref> <remote sha>
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo "✖ Pushing to main is blocked. Push your branch and open a pull request:"
    echo "    git push -u origin HEAD && gh pr create"
    echo "  (Emergency only: git push --no-verify)"
    exit 1
  fi
done
exit 0
